<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view" android:layout_width="match_parent"
        android:layout_height="match_parent" android:keepScreenOn="true"
        app:surface_type="surface_view" />
    <View android:id="@+id/player_gesture_overlay" android:layout_width="match_parent"
        android:layout_height="match_parent" android:background="@android:color/transparent"
        android:clickable="true" android:focusable="false" />
    <FrameLayout android:id="@+id/player_controls"
        android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:id="@+id/player_top_bar" android:layout_width="match_parent"
            android:layout_height="56dp" android:layout_gravity="top" android:layout_marginTop="12dp" android:gravity="center_vertical"
            android:orientation="horizontal" android:background="@android:color/transparent" android:paddingStart="8dp" android:paddingEnd="8dp">
            <ImageButton android:id="@+id/player_close" android:layout_width="38dp" android:layout_height="38dp"
                android:background="@drawable/bg_player_glass_circle" android:contentDescription="Back"
                android:src="@drawable/ic_player_back" android:tint="#FFFFFF" />
            <TextView android:id="@+id/player_title" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="18dp" android:layout_marginEnd="6dp" android:layout_weight="1"
                android:singleLine="true" android:ellipsize="marquee" android:marqueeRepeatLimit="marquee_forever" android:scrollHorizontally="true"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/player_cc" android:layout_width="38dp" android:layout_height="40dp"
                android:layout_marginStart="4dp" android:visibility="gone" android:gravity="center" android:text="CC" android:textColor="#FFFFFF" android:textStyle="bold"
                android:background="@drawable/bg_player_toolbar_btn" />
            <ImageButton android:id="@+id/player_more" android:layout_width="40dp" android:layout_height="40dp"
                android:layout_marginStart="4dp" android:layout_marginEnd="7dp" android:background="@android:color/transparent"
                android:contentDescription="More player options" android:src="@drawable/ic_player_more" android:tint="#FFFFFF" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:gravity="center" android:orientation="horizontal" android:layout_marginStart="7dp" android:layout_marginEnd="10dp">
                <FrameLayout android:layout_width="12dp" android:layout_height="20dp">
                    <ImageView android:layout_width="12dp" android:layout_height="20dp"
                        android:src="@drawable/ic_player_battery_vertical" android:contentDescription="Battery" />
                    <View android:id="@+id/player_battery_fill" android:layout_width="6dp" android:layout_height="10dp"
                        android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="3dp"
                        android:background="#FFD60A" />
                </FrameLayout>
                <TextView android:id="@+id/player_battery" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="4dp" android:text="--%" android:textColor="#FFFFFF" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:gravity="center_vertical" android:singleLine="true" android:includeFontPadding="false" />
            </LinearLayout>
            <TextView android:id="@+id/player_clock" android:layout_width="48dp" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:layout_marginEnd="10dp" android:gravity="center_vertical|center_horizontal" android:text="00:00" android:textColor="#FFFFFF" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <LinearLayout android:id="@+id/player_center_controls" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center"
            android:orientation="horizontal">
            <ImageButton android:id="@+id/player_rewind" android:layout_width="52dp" android:layout_height="52dp"
                android:layout_marginEnd="44dp" android:background="@drawable/bg_player_control_ripple"
                android:contentDescription="Rewind 10 seconds" android:src="@drawable/ic_player_rewind" android:tint="#FFFFFF" />
            <ImageButton android:id="@+id/player_play" android:layout_width="68dp" android:layout_height="68dp"
                android:background="@drawable/bg_player_control_ripple" android:contentDescription="Play or pause"
                android:padding="16dp" android:src="@drawable/ic_player_play" android:tint="#FFFFFF" />
            <ImageButton android:id="@+id/player_forward" android:layout_width="52dp" android:layout_height="52dp"
                android:layout_marginStart="44dp" android:background="@drawable/bg_player_control_ripple"
                android:contentDescription="Forward 10 seconds" android:src="@drawable/ic_player_forward" android:tint="#FFFFFF" />
        </LinearLayout>

        <LinearLayout android:id="@+id/player_bottom_panel" android:background="@android:color/transparent" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical"
            android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingBottom="5dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingTop="2dp" android:paddingBottom="3dp">
                <com.jet.downloader.player.RoundedTimeBar
                    android:id="@+id/player_seek" android:layout_width="match_parent" android:layout_height="40dp"
                    android:layout_marginStart="50dp" android:layout_marginEnd="50dp"
                    android:paddingStart="0dp" android:paddingEnd="0dp"
                    android:background="@android:color/transparent" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="18dp"
                    android:layout_marginStart="50dp" android:layout_marginEnd="50dp"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/player_current_time" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0:00" android:textColor="#FFFFFFFF"
                        android:textSize="15sp" android:textStyle="bold" android:fontFamily="monospace" />
                    <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                    <TextView android:id="@+id/player_duration" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0:00" android:textColor="#CCFFFFFF"
                        android:textSize="15sp" android:textStyle="bold" android:fontFamily="monospace" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/player_bottom_icons" android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginStart="60dp" android:layout_marginEnd="60dp"
                android:gravity="center" android:orientation="horizontal">
                <ImageButton android:id="@+id/player_lock" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginHorizontal="2dp" android:padding="9dp" android:background="@android:color/transparent" android:tint="#FFFFFF" android:contentDescription="Lock" android:src="@drawable/ic_player_lock" />
                <ImageButton android:id="@+id/player_mute" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginHorizontal="2dp" android:padding="8dp" android:background="@android:color/transparent" android:tint="#FFFFFF" android:contentDescription="Mute" android:src="@drawable/ic_player_mute" />
                <ImageButton android:id="@+id/player_pip" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginHorizontal="2dp" android:padding="9dp" android:background="@android:color/transparent" android:tint="#FFFFFF" android:contentDescription="Picture in picture" android:src="@drawable/ic_player_pip" />
                <ImageButton android:id="@+id/player_aspect" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginHorizontal="2dp" android:padding="9dp" android:background="@android:color/transparent" android:tint="#FFFFFF" android:contentDescription="Zoom mode" android:src="@drawable/ic_player_zoom" />
                <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginHorizontal="2dp">
                    <ImageButton android:id="@+id/player_speed" android:layout_width="match_parent" android:layout_height="match_parent"
                        android:padding="9dp" android:background="@android:color/transparent" android:contentDescription="Playback speed"
                        android:src="@drawable/ic_player_speed" android:tint="#FFFFFF" />
                    <TextView android:id="@+id/player_speed_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end" android:layout_marginEnd="2dp" android:layout_marginBottom="2dp" android:gravity="center" android:paddingHorizontal="2dp" android:text="1.0x" android:textColor="#FFFFFF" android:textSize="7sp" android:background="@drawable/bg_player_speed_badge" />
                </FrameLayout>
                <ImageButton android:id="@+id/player_background" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginHorizontal="2dp" android:padding="9dp" android:background="@android:color/transparent" android:tint="#FFFFFF" android:contentDescription="Background audio" android:src="@drawable/ic_player_headphones" />
                <ImageButton android:id="@+id/player_rotate" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginHorizontal="2dp" android:padding="9dp" android:background="@android:color/transparent" android:tint="#FFFFFF" android:contentDescription="Rotate" android:src="@drawable/ic_player_rotate" />
                <ImageButton android:id="@+id/player_playlist_toggle" android:layout_width="40dp" android:layout_height="40dp"
                    android:layout_marginStart="5dp" android:padding="9dp" android:background="@drawable/bg_player_control_ripple"
                    android:contentDescription="Open playlist" android:src="@drawable/ic_player_playlist" android:tint="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/player_brightness_hud" android:layout_width="36dp" android:layout_height="212dp"
            android:layout_gravity="center_vertical|end" android:layout_marginEnd="14dp" android:gravity="center"
            android:orientation="vertical" android:paddingStart="2dp" android:paddingEnd="2dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:background="@drawable/bg_player_hud_pill" android:elevation="2dp" android:visibility="gone">
            <ImageView android:id="@+id/player_brightness_icon" android:layout_width="20dp" android:layout_height="20dp"
                android:contentDescription="Brightness" android:src="@drawable/ic_player_brightness" android:tint="#FFFFFF" />
            <ProgressBar android:id="@+id/player_hud_progress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="4dp" android:layout_height="140dp"
                android:progressDrawable="@drawable/bg_player_vertical_progress" android:max="100" />
            <TextView android:id="@+id/player_hud_percent" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:singleLine="true" android:layout_marginTop="5dp" android:layout_marginBottom="2dp" android:paddingHorizontal="2dp" android:text="50%" android:textColor="#FFFFFF" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/player_volume_hud" android:layout_width="36dp" android:layout_height="212dp"
            android:layout_gravity="center_vertical|start" android:layout_marginStart="14dp" android:gravity="center"
            android:orientation="vertical" android:paddingStart="2dp" android:paddingEnd="2dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:background="@drawable/bg_player_hud_pill" android:elevation="2dp" android:visibility="gone">
            <ImageView android:id="@+id/player_volume_icon" android:layout_width="20dp" android:layout_height="20dp"
                android:contentDescription="Volume" android:src="@drawable/ic_player_volume_on" android:tint="#FFFFFF" />
            <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:id="@+id/player_volume_progress"
                android:layout_width="4dp" android:layout_height="140dp"
                android:progressDrawable="@drawable/bg_player_vertical_progress" android:max="100" />
            <TextView android:id="@+id/player_volume_percent" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:singleLine="true" android:layout_marginTop="5dp" android:layout_marginBottom="2dp" android:paddingHorizontal="2dp" android:text="50%" android:textColor="#FFFFFF" android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/player_seek_hud" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:orientation="vertical" android:gravity="center"
            android:paddingHorizontal="22dp" android:paddingVertical="14dp" android:background="@android:color/transparent" android:elevation="0dp" android:outlineProvider="none"
            android:visibility="gone">
            <TextView android:id="@+id/player_seek_target" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="00:00" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:id="@+id/player_seek_delta" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="+00:10" android:textColor="#DDFFFFFF" android:textSize="13sp" />
        </LinearLayout>
        <TextView android:id="@+id/player_zoom_hud" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:paddingHorizontal="18dp" android:paddingVertical="9dp"
            android:background="@drawable/bg_player_hud_pill" android:text="FIT" android:textColor="#FFFFFF"
            android:textStyle="bold" android:visibility="gone" />
        <FrameLayout android:id="@+id/player_left_tap_hud" android:layout_width="150dp" android:layout_height="190dp"
            android:layout_gravity="center_vertical|start" android:background="@drawable/bg_player_tap_ripple" android:visibility="gone">
            <TextView android:id="@+id/player_left_tap_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:text="« 10s" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
        </FrameLayout>
        <FrameLayout android:id="@+id/player_right_tap_hud" android:layout_width="150dp" android:layout_height="190dp"
            android:layout_gravity="center_vertical|end" android:background="@drawable/bg_player_tap_ripple" android:visibility="gone">
            <TextView android:id="@+id/player_right_tap_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:text="10s »" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
        </FrameLayout>

    </FrameLayout>
    <TextView android:id="@+id/player_seek_pill" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_gravity="center"
        android:translationY="-54dp" android:paddingHorizontal="20dp" android:paddingVertical="10dp"
        android:background="@android:color/transparent" android:elevation="0dp" android:outlineProvider="none" android:text="00:00/00:00"
        android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"
        android:visibility="gone" />
    <View android:id="@+id/player_playlist_scrim" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#99000000" android:clickable="true" android:focusable="true" android:visibility="gone" />
    <LinearLayout android:id="@+id/player_playlist_drawer" android:layout_width="320dp" android:layout_height="match_parent" android:layout_gravity="end" android:orientation="vertical" android:background="#10131B" android:elevation="18dp" android:paddingTop="0dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingBottom="14dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Videos" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
            <ImageButton android:id="@+id/player_playlist_close" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_player_control_ripple" android:src="@drawable/ic_player_back" android:tint="#FFFFFF" android:contentDescription="Close playlist" />
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/player_playlist_list"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:clipToPadding="false" android:paddingBottom="8dp" android:scrollbars="none" />
    </LinearLayout>
    <ImageButton android:id="@+id/player_unlock" android:layout_width="36dp" android:layout_height="36dp"
        android:layout_gravity="top|start" android:layout_marginStart="14dp" android:layout_marginTop="14dp"
        android:padding="9dp" android:background="@drawable/bg_player_glass_circle"
        android:src="@drawable/ic_player_lock_corner" android:tint="#FFFFFF"
        android:contentDescription="Unlock screen" android:visibility="gone" />
</FrameLayout>