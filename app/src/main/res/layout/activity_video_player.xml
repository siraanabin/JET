<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view" android:layout_width="match_parent"
        android:layout_height="match_parent" android:keepScreenOn="true" />
    <View android:layout_width="match_parent" android:layout_height="68dp"
        android:layout_gravity="top" android:background="@drawable/player_top_gradient" />
    <View android:layout_width="match_parent" android:layout_height="190dp"
        android:layout_gravity="bottom" android:background="@drawable/player_bottom_gradient" />
    <FrameLayout android:id="@+id/player_controls"
        android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:id="@+id/player_top_bar" android:layout_width="match_parent"
            android:layout_height="56dp" android:layout_gravity="top" android:gravity="center_vertical"
            android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp">
            <ImageButton android:id="@+id/player_close" android:layout_width="40dp" android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Back"
                android:src="@drawable/ic_player_back" android:tint="#FFFFFF" />
            <TextView android:id="@+id/player_title" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:ellipsize="marquee" android:singleLine="true"
                android:marqueeRepeatLimit="marquee_forever" android:focusable="true" android:focusableInTouchMode="true"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/player_cc" android:layout_width="40dp" android:layout_height="40dp"
                android:gravity="center" android:text="CC" android:textColor="#FFFFFF" android:textStyle="bold"
                android:background="?android:attr/selectableItemBackgroundBorderless" />
            <TextView android:id="@+id/player_battery" android:layout_width="52dp" android:layout_height="wrap_content"
                android:gravity="center" android:text="▰ --%" android:textColor="#FFFFFF" android:textSize="11sp" />
            <TextView android:id="@+id/player_clock" android:layout_width="42dp" android:layout_height="wrap_content"
                android:gravity="center" android:text="00:00" android:textColor="#FFFFFF" android:textSize="12sp" />
            <ImageButton android:id="@+id/player_more" android:layout_width="40dp" android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="More"
                android:src="@drawable/ic_player_more" android:tint="#FFFFFF" />
        </LinearLayout>

        <LinearLayout android:id="@+id/player_center_controls" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center"
            android:orientation="horizontal">
            <ImageButton android:id="@+id/player_rewind" android:layout_width="52dp" android:layout_height="52dp"
                android:layout_marginEnd="44dp" android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Rewind 10 seconds" android:src="@drawable/ic_player_rewind" android:tint="#FFFFFF" />
            <ImageButton android:id="@+id/player_play" android:layout_width="68dp" android:layout_height="68dp"
                android:background="@drawable/player_play_glass" android:contentDescription="Play or pause"
                android:padding="14dp" android:src="@drawable/ic_player_play" android:tint="#FFFFFF" />
            <ImageButton android:id="@+id/player_forward" android:layout_width="52dp" android:layout_height="52dp"
                android:layout_marginStart="44dp" android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Forward 10 seconds" android:src="@drawable/ic_player_forward" android:tint="#FFFFFF" />
        </LinearLayout>

        <LinearLayout android:id="@+id/player_bottom_panel" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical"
            android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingBottom="5dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="36dp"
                android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/player_current_time" android:layout_width="52dp"
                    android:layout_height="wrap_content" android:text="0:00" android:textColor="#FFFFFF" android:textSize="12sp" />
                <androidx.media3.ui.DefaultTimeBar android:id="@+id/player_seek"
                    android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1"
                    app:bar_height="5dp" app:touch_target_height="32dp" app:scrubber_enabled_size="16dp"
                    app:scrubber_dragged_size="22dp" app:played_color="#FFFFFFFF" app:scrubber_color="#FFFFFFFF"
                    app:buffered_color="#66FFFFFF" app:unplayed_color="#55FFFFFF" />
                <TextView android:id="@+id/player_duration" android:layout_width="52dp"
                    android:layout_height="wrap_content" android:gravity="end" android:text="0:00"
                    android:textColor="#FFFFFF" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                android:gravity="center" android:orientation="horizontal">
                <ImageButton android:id="@+id/player_lock" style="@style/PlayerToolbarButton" android:contentDescription="Lock" android:src="@drawable/ic_player_lock" />
                <ImageButton android:id="@+id/player_mute" style="@style/PlayerToolbarButton" android:contentDescription="Mute" android:src="@drawable/ic_player_mute" />
                <ImageButton android:id="@+id/player_pip" style="@style/PlayerToolbarButton" android:contentDescription="Picture in picture" android:src="@drawable/ic_player_pip" />
                <ImageButton android:id="@+id/player_aspect" style="@style/PlayerToolbarButton" android:contentDescription="Zoom mode" android:src="@drawable/ic_player_zoom" />
                <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:layout_marginHorizontal="3dp">
                    <ImageButton android:id="@+id/player_speed" android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Playback speed"
                        android:src="@drawable/ic_player_speed" android:tint="#FFFFFF" />
                    <TextView android:id="@+id/player_speed_label" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_gravity="bottom" android:gravity="center" android:text="1x" android:textColor="#FFFFFF" android:textSize="8sp" />
                </FrameLayout>
                <ImageButton android:id="@+id/player_background" style="@style/PlayerToolbarButton" android:contentDescription="Background audio" android:src="@drawable/ic_player_headphones" />
                <ImageButton android:id="@+id/player_rotate" style="@style/PlayerToolbarButton" android:contentDescription="Rotate" android:src="@drawable/ic_player_rotate" />
            </LinearLayout>
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="54dp"
                android:fillViewport="false" android:scrollbars="none">
                <LinearLayout android:id="@+id/player_playlist" android:layout_width="wrap_content"
                    android:layout_height="match_parent" android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <LinearLayout android:id="@+id/player_brightness_hud" android:layout_width="48dp" android:layout_height="170dp"
            android:layout_gravity="center_vertical|start" android:layout_marginStart="28dp" android:gravity="center"
            android:orientation="vertical" android:padding="8dp" android:background="@drawable/player_hud_bg" android:visibility="gone">
            <TextView android:id="@+id/player_brightness_icon" android:layout_width="wrap_content" android:layout_height="28dp"
                android:text="☼" android:textColor="#FFFFFF" android:textSize="22sp" />
            <ProgressBar android:id="@+id/player_hud_progress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="110dp" android:layout_height="6dp" android:rotation="-90"
                android:max="100" android:progressTint="#FFFFFF" android:progressBackgroundTint="#55FFFFFF" />
            <TextView android:id="@+id/player_hud_percent" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="50%" android:textColor="#FFFFFF" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/player_volume_hud" android:layout_width="48dp" android:layout_height="170dp"
            android:layout_gravity="center_vertical|end" android:layout_marginEnd="28dp" android:gravity="center"
            android:orientation="vertical" android:padding="8dp" android:background="@drawable/player_hud_bg" android:visibility="gone">
            <TextView android:id="@+id/player_volume_icon" android:layout_width="wrap_content" android:layout_height="28dp"
                android:text="◖" android:textColor="#FFFFFF" android:textSize="22sp" />
            <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:id="@+id/player_volume_progress" android:layout_width="110dp"
                android:layout_height="6dp" android:rotation="-90" android:max="100"
                android:progressTint="#FFFFFF" android:progressBackgroundTint="#55FFFFFF" />
            <TextView android:id="@+id/player_volume_percent" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="50%" android:textColor="#FFFFFF" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/player_seek_hud" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:orientation="vertical" android:gravity="center"
            android:paddingHorizontal="22dp" android:paddingVertical="14dp" android:background="@drawable/player_seek_hud_bg"
            android:visibility="gone">
            <TextView android:id="@+id/player_seek_target" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="00:00" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:id="@+id/player_seek_delta" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="+00:10" android:textColor="#DDFFFFFF" android:textSize="13sp" />
        </LinearLayout>
        <TextView android:id="@+id/player_zoom_hud" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:paddingHorizontal="18dp" android:paddingVertical="9dp"
            android:background="@drawable/player_hud_bg" android:text="FIT" android:textColor="#FFFFFF"
            android:textStyle="bold" android:visibility="gone" />
        <FrameLayout android:id="@+id/player_left_tap_hud" android:layout_width="150dp" android:layout_height="190dp"
            android:layout_gravity="center_vertical|start" android:background="@drawable/player_ripple_left" android:visibility="gone">
            <TextView android:id="@+id/player_left_tap_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:text="« 10s" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
        </FrameLayout>
        <FrameLayout android:id="@+id/player_right_tap_hud" android:layout_width="150dp" android:layout_height="190dp"
            android:layout_gravity="center_vertical|end" android:background="@drawable/player_ripple_right" android:visibility="gone">
            <TextView android:id="@+id/player_right_tap_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:text="10s »" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
        </FrameLayout>
    </FrameLayout>
    <Button android:id="@+id/player_unlock" android:layout_width="wrap_content" android:layout_height="48dp"
        android:layout_gravity="center" android:text="Unlock" android:textColor="#FFFFFF"
        android:backgroundTint="#CC202020" android:visibility="gone" />
</FrameLayout>