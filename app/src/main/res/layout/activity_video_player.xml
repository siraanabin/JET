<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view" android:layout_width="match_parent"
        android:layout_height="match_parent" android:keepScreenOn="true" />
    <LinearLayout
        android:id="@+id/player_controls" android:layout_width="match_parent"
        android:layout_height="match_parent" android:orientation="vertical"
        android:background="#33000000" android:paddingStart="18dp"
        android:paddingEnd="18dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
            android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton android:id="@+id/player_close" android:layout_width="42dp"
                android:layout_height="44dp" android:background="@android:color/transparent"
                android:contentDescription="Minimize" android:src="@android:drawable/arrow_down_float"
                android:tint="#FFFFFF" />
            <TextView android:id="@+id/player_title" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:ellipsize="marquee" android:singleLine="true"
                android:marqueeRepeatLimit="marquee_forever" android:focusable="true"
                android:focusableInTouchMode="true" android:textColor="#FFFFFF"
                android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/player_cc" android:layout_width="38dp"
                android:layout_height="wrap_content" android:gravity="center"
                android:text="CC" android:textColor="#FFFFFF" android:textStyle="bold" />
            <TextView android:id="@+id/player_battery" android:layout_width="54dp"
                android:layout_height="wrap_content" android:gravity="center"
                android:text="▰ --%" android:textColor="#FFFFFF" android:textSize="12sp" />
            <TextView android:id="@+id/player_clock" android:layout_width="48dp"
                android:layout_height="wrap_content" android:gravity="center"
                android:text="00:00" android:textColor="#FFFFFF" android:textSize="12sp" />
            <ImageButton android:id="@+id/player_more" android:layout_width="40dp"
                android:layout_height="44dp" android:background="@android:color/transparent"
                android:contentDescription="More options" android:src="@android:drawable/ic_menu_more"
                android:tint="#FFFFFF" />
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:gravity="center" android:orientation="horizontal">
                <TextView android:id="@+id/player_rewind" android:layout_width="76dp"
                    android:layout_height="76dp" android:gravity="center" android:text="↶ 10"
                    android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:id="@+id/player_play" android:layout_width="90dp"
                    android:layout_height="90dp" android:gravity="center" android:text="▶"
                    android:textColor="#FFFFFF" android:textSize="42sp" android:textStyle="bold" />
                <TextView android:id="@+id/player_forward" android:layout_width="76dp"
                    android:layout_height="76dp" android:gravity="center" android:text="10 ↷"
                    android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_gravity="bottom" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/player_current_time" android:layout_width="52dp"
                    android:layout_height="wrap_content" android:text="0:00"
                    android:textColor="#FFFFFF" android:textSize="12sp" />
                <SeekBar android:id="@+id/player_seek" android:layout_width="0dp"
                    android:layout_height="40dp" android:layout_weight="1" android:max="1000"
                    android:minHeight="24dp" android:maxHeight="8dp"
                    android:progressDrawable="@drawable/player_seekbar"
                    android:thumbTint="#FFFFFF" android:splitTrack="false" />
                <TextView android:id="@+id/player_duration" android:layout_width="52dp"
                    android:layout_height="wrap_content" android:gravity="end"
                    android:text="0:00" android:textColor="#FFFFFF" android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
            android:gravity="center_vertical" android:orientation="horizontal">
            <Button android:id="@+id/player_lock" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:minWidth="0dp" android:text="Lock" android:textSize="10sp" />
            <Button android:id="@+id/player_mute" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:minWidth="0dp" android:text="Mute" android:textSize="10sp" />
            <Button android:id="@+id/player_pip" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:minWidth="0dp" android:text="PiP" android:textSize="10sp" />
            <Button android:id="@+id/player_aspect" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:minWidth="0dp" android:text="Fit" android:textSize="10sp" />
            <Button android:id="@+id/player_speed" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:minWidth="0dp" android:text="1.0x" android:textSize="10sp" />
            <Button android:id="@+id/player_background" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:minWidth="0dp" android:text="Audio" android:textSize="10sp" />
            <Button android:id="@+id/player_rotate" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:minWidth="0dp" android:text="Rotate" android:textSize="10sp" />
        </LinearLayout>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="90dp"
            android:fillViewport="false" android:scrollbars="none">
            <LinearLayout android:id="@+id/player_playlist" android:layout_width="wrap_content"
                android:layout_height="match_parent" android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>
    <Button
        android:id="@+id/player_unlock"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:text="Unlock"
        android:textColor="#FFFFFF"
        android:backgroundTint="#CC202020"
        android:visibility="gone" />
</FrameLayout>