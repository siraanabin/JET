ts() && !updatesDir.mkdirs()) {
                    throw IOException("Could not create update cache")
                }
                val apkFile = File(updatesDir, "JET-update.apk")
                if (apkFile.exists()) apkFile.delete()

                val request = Request.Builder().url(apkUrl).build()
                updateHttpClient.newCall(request).execute().use { response ->
                    if (!response.isSuccessful) {
                        throw IOException("APK download failed (HTTP ${response.code})")
                    }
                    val body = response.body ?: throw IOException("Empty APK response")
                    val totalBytes = body.contentLength()
                    var downloaded = 0L
                    var lastReportedPercent = -1
                    body.byteStream().use { input ->
                        apkFile.outputStream().buffered().use { output ->
                            val buffer = ByteArray(16 * 1024)
                            while (true) {
                                val count = input.read(buffer)
                                if (count == -1) break
                                output.write(buffer, 0, count)
                                downloaded += count
                                if (totalBytes > 0) {
                                    val percent = ((downloaded * 100L) / totalBytes)
                                        .toInt().coerceIn(0, 100)
                                    if (percent != lastReportedPercent) {
                                        lastReportedPercent = percent
                                        val label = String.format(
                                            java.util.Locale.US,
                                            "%.1f / %.1f MB",
                                            downloaded / 1048576.0,
                                            totalBytes / 1048576.0
                                        )
                                        sendJsCallback(
                                            "onNativeAppUpdateProgress",
                                            percent,
                                            label
                                        )
                                    }
                                }
                            }
                        }
                    }
                }

                if (!apkFile.exists() || apkFile.length() <= 0L) {
                    throw IOException("Downloaded APK is empty")
                }

                sendJsCallback("onNativeAppUpdateProgress", 100, "Download complete")
                runOnUiThread {
                    pendingInstallFile = apkFile
                    if (canInstallPackages()) {
                        pendingInstallFile = null
                        installDownloadedApk(apkFile)
                    } else {
                        Toast.makeText(
                            this,
                            "Allow JET to install unknown apps, then return here",
                            Toast.LENGTH_LONG
                        ).show()
                        val settingsIntent = Intent(
                            Settings.ACTION_MANAGE_UNKNOWN_APP_SOURCES,
                            Uri.parse("package:$packageName")
                        )
                        startActivity(settingsIntent)
                    }
                }
            } catch (error: Exception) {
                sendJsCallback(
                    "onNativeAppUpdateError",
                    error.message ?: "APK download failed"
                )
            }
        }
    }

    private fun installDownloadedApk(apkFile: File) {
        try {
            val apkUri = FileProvider.getUriForFile(
                this,
                "$packageName.fileprovider",
                apkFile
            )
            val installIntent = Intent(Intent.ACTION_VIEW).apply {
                setDataAndType(apkUri, "application/vnd.android.package-archive")
                addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
                addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
            }
            startActivity(installIntent)
        } catch (error: Exception) {
            sendJsCallback(
                "onNativeAppUpdateError",
                error.message ?: "Could not open Android installer"
            )
        }
    }

