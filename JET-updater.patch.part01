+    override fun onResume() {
+        super.onResume()
+        if (::webView.isInitialized) {
+            webView.postDelayed({ checkSystemClipboard() }, 350)
+        }
+        val waitingFile = pendingInstallFile
+        if (waitingFile != null && canInstallPackages()) {
+            pendingInstallFile = null
+            installDownloadedApk(waitingFile)
+        }
+    }
+
+    override fun onDestroy() {
+        updateExecutor.shutdownNow()
+        super.onDestroy()
+    }
+
+    private fun currentVersionCode(): Long {
+        val info = packageManager.getPackageInfo(packageName, 0)
+        return PackageInfoCompat.getLongVersionCode(info)
+    }
+
+    private fun currentVersionName(): String {
+        return packageManager.getPackageInfo(packageName, 0).versionName ?: "unknown"
+    }
+
+    private fun canInstallPackages(): Boolean {
+        return Build.VERSION.SDK_INT < Build.VERSION_CODES.O ||
+            packageManager.canRequestPackageInstalls()
+    }
+
+    private fun sendJsCallback(functionName: String, vararg args: Any?) {
+        if (!::webView.isInitialized || isFinishing || isDestroyed) return
+        val jsonArgs = JSONArray()
+        args.forEach { value -> jsonArgs.put(value) }
+        runOnUiThread {
+            if (!::webView.isInitialized || isFinishing || isDestroyed) return@runOnUiThread
+            webView.evaluateJavascript(
+                "if (window.$functionName) window.$functionName.apply(window, $jsonArgs);",
+                null
+            )
+        }
+    }
+
+    private fun checkForAppUpdate(manual: Boolean) {
+        updateExecutor.execute {
+            try {
+                val request = Request.Builder()
+                    .url(versionJsonUrl)
+                    .header("Cache-Control", "no-cache")
+                    .build()
+                updateHttpClient.newCall(request).execute().use { response ->
+                    if (!response.isSuccessful) {
+                        throw IOException("Version check failed (HTTP ${response.code})")
+                    }
+                    val body = response.body?.string()
+                        ?: throw IOException("Empty version information")
+                    val remote = JSONObject(body)
+                    val remoteCode = remote.optLong("versionCode", -1L)
+                    val remoteName = remote.optString("versionName", "")
+                    val apkUrl = remote.optString("apkUrl", "")
+                    val changelog = remote.optString("changelog", "")
+
+                    if (remoteCode <= 0 || remoteName.isBlank() ||
+                        !apkUrl.startsWith("https://")) {
+                        throw IOException("Invalid version.json")
+                    }
+
+                    val installedCode = currentVersionCode()
+                    val installedName = currentVersionName()
+                    if (remoteCode > installedCode) {
+                        sendJsCallback(
+                            "onNativeAppUpdateAvailable",
+                            remoteName,
+                            changelog,
+                            apkUrl
+                        )
+                    } else if (manual) {
+                        sendJsCallback("onNativeAppUpdateNotAvailable", installedName)
+                    }
+                }
+            } catch (error: Exception) {
+                if (manual) {
+                    sendJsCallback(
+                        "onNativeAppUpdateError",
+                        error.message ?: "Could not check for updates"
+                    )
+                }
+            }
+        }
+    }

