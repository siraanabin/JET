-      $('check-app-update-btn').addEventListener('click', () => {
-        if (state.appUpdated) {
-          showToast('You are running the latest JET v3.3.0');
-          return;
-        }
+      let availableApkUrl = null;
+
+      function escapeUpdateText(value) {
+        return String(value || '').replace(/[&<>"']/g, (char) => ({
+          '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
+        })[char]);
+      }
+
+      window.onNativeAppUpdateAvailable = function (versionName, changelog, apkUrl) {
+        availableApkUrl = apkUrl;
+        const lines = String(changelog || 'Bug fixes and improvements')
+          .split(/\r?\n|•/)
+          .map(line => line.trim())
+          .filter(Boolean);
+        const changesHtml = lines.map(line =>
+          `<li class="text-[11px] text-app-secondary">${escapeUpdateText(line)}</li>`
+        ).join('');
+        openUtilityModal('App Update Available', `
+          <div class="p-3 rounded-2xl bg-app-elevated space-y-2">
+            <p class="text-sm font-extrabold text-app-text">JET v${escapeUpdateText(versionName)}</p>
+            <ul class="list-disc pl-4 space-y-1">${changesHtml}</ul>
+            <p id="app-update-progress-label" class="text-[11px] text-app-secondary">Ready to download</p>
+            <div class="h-2 rounded-full bg-app-border overflow-hidden">
+              <div id="app-update-progress-bar" class="h-full bg-app-primary" style="width:0%"></div>
+            </div>
+          </div>
+          <button id="install-app-update-btn" type="button" class="w-full h-11 rounded-2xl bg-app-primary text-white text-xs font-bold">Download & Install</button>
+        `);
+        $('install-app-update-btn').addEventListener('click', () => {
+          if (!availableApkUrl || !window.JetAndroid) {
+            showToast('Native Android updater is unavailable');
+            return;
+          }
+          $('install-app-update-btn').disabled = true;
+          $('install-app-update-btn').textContent = 'Downloading…';
+          window.JetAndroid.downloadAndInstallAppUpdate(availableApkUrl);
+        });
+      };
+
+      window.onNativeAppUpdateNotAvailable = function (installedVersion) {
+        $('app-version-text').textContent = `JET v${installedVersion} · Up to date`;
+        showToast(`You are running the latest JET v${installedVersion}`);
+      };
+
+      window.onNativeAppUpdateError = function (message) {
+        showToast(`Update error: ${message}`);
+        const button = $('install-app-update-btn');
+        if (button) {
+          button.disabled = false;
+          button.textContent = 'Try Again';
+        }
+        const label = $('app-update-progress-label');
+        if (label) label.textContent = message;
+      };
+
+      window.onNativeAppUpdateProgress = function (percent, label) {
+        const bar = $('app-update-progress-bar');
+        const status = $('app-update-progress-label');
+        if (bar) bar.style.width = `${Math.max(0, Math.min(100, Number(percent) || 0)}%`;
+        if (status) status.textContent = label || `Downloading ${percent}%`;
+        const button = $('install-app-update-btn');
+        if (button) button.textContent = `Downloading ${percent}%`;
+      };
+
+      $('check-app-update-btn').addEventListener('click', () => {
+        if (window.JetAndroid && window.JetAndroid.checkForAppUpdate) {
+          $('check-app-update-btn').disabled = true;
+          $('check-app-update-btn').textContent = 'Checking…';
+          window.JetAndroid.checkForAppUpdate(true);
+          setTimeout(() => {
+            $('check-app-update-btn').disabled = false;
+            $('check-app-update-btn').textContent = 'Check for Updates';
+          }, 2500);
+        } else {
+          showToast('App updates are available only in the Android app');
+        }
       });
 
       $('clear-cache-btn').addEventListener('click', () => {
